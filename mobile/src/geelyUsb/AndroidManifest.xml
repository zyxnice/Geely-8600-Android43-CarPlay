<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:label="@string/geely_usb_app_name" tools:replace="android:label">
        <!-- Parked, explicit diagnostic only. No boot or automatic speech binding. -->
        <receiver android:name="com.shilapi.xcertplay.GeelyPhoneNavigationProbeReceiver"
            android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.shihab.diplay.geely.PHONE_NAVIGATION_PROBE" />
            </intent-filter>
        </receiver>
        <meta-data android:name="com.shilapi.xcertplay.GEELY_NAVIGATION_OBSERVE" android:value="true" />
        <!-- Restore only this app's previously confirmed VPN trust after a new H53 kernel boot. -->
        <meta-data android:name="com.shilapi.xcertplay.GEELY_VPN_RESTORE" android:value="true" />
        <meta-data android:name="com.shilapi.xcertplay.GEELY_MEDIA_STAGE"
            android:value="${geelyMediaStage}" />
        <!-- Absent in ordinary builds: the code's explicit default is false. -->
        <meta-data
            android:name="com.shilapi.xcertplay.GEELY_USB_RUNTIME_RECOVERY"
            android:value="true" />
        <meta-data
            android:name="com.shilapi.xcertplay.GEELY_USB_BYPASS"
            android:value="true" />
    </application>
</manifest>
